<Window x:Class="WorkDelta.App.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目设置 - 工迹 WorkDelta" Width="620" Height="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="项目设置" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18" />
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="显示名称" Margin="0,0,0,6" />
            <TextBox x:Name="NameTextBox" Padding="9" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="项目文件夹" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PathTextBox" Padding="9" />
                <Button Grid.Column="1" Content="选择…" Click="Browse_Click" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="自定义排除规则" Margin="0,0,0,6" />
            <TextBlock Text="每行一条，可使用 * 和 ?，例如 generated/* 或 *.secret" Foreground="#667085" FontSize="11" Margin="0,0,0,7" />
            <TextBox x:Name="IgnoreTextBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="150" Padding="9" />
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Button Content="删除项目记录" Foreground="#B42318" HorizontalAlignment="Left" Click="Delete_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="保存" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
