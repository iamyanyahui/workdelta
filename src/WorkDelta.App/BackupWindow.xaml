<Window x:Class="WorkDelta.App.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WorkDelta.App.Localization"
        Icon="/WorkDelta;component/Assets/WorkDelta.ico"
        Title="{loc:Loc BackupTitle}" Width="560" Height="350"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI">
    <StackPanel Margin="28">
        <TextBlock Text="{loc:Loc BackupAndRestore}" FontSize="23" FontWeight="SemiBold" />
        <Border Background="White" CornerRadius="10" Padding="18" Margin="0,20,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Loc ExportFullBackup}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc BackupDescription}" Foreground="#667085" Margin="0,7,0,12" />
                <Button Content="{loc:Loc ExportBackupButton}" HorizontalAlignment="Left" Click="Export_Click" />
            </StackPanel>
        </Border>
        <Border Background="White" CornerRadius="10" Padding="18">
            <StackPanel>
                <TextBlock Text="{loc:Loc RestoreFromBackup}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc RestoreDescription}" Foreground="#667085" Margin="0,7,0,12" />
                <Button Content="{loc:Loc ChooseBackupButton}" HorizontalAlignment="Left" Click="Restore_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
