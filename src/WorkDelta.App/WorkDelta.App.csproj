<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WorkDelta</AssemblyName>
    <RootNamespace>WorkDelta.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WorkDelta.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WorkDelta.Core/WorkDelta.Core.csproj" />
    <Resource Include="Assets\WorkDelta.ico" />
    <Resource Include="..\..\site\assets\workdelta-icon.png">
      <Link>Assets\WorkDelta.png</Link>
    </Resource>
    <Resource Include="..\..\site\assets\support\*.png">
      <Link>Assets\Support\%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>
</Project>
