<Window x:Class="WorkDelta.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史与恢复 - 工迹 WorkDelta" Width="1100" Height="720"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="历史检查点" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
            <DataGrid x:Name="SnapshotGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="SnapshotGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding LocalTime}" Width="145" />
                    <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="80" />
                    <DataGridTextColumn Header="文件" Binding="{Binding Summary}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="发生变化的文件" FontWeight="SemiBold" Margin="0,14,0,8" />
            <ListBox x:Name="FileList" Grid.Row="3" SelectionChanged="FileList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,5">
                            <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#667085" Margin="0,3,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="恢复选中文件" Click="RestoreFile_Click" Margin="0,0,8,0" />
                <Button Content="恢复整个检查点" Click="RestoreSnapshot_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="DiffTitle" Text="选择一个文件查看具体变化" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,10" />
            <TextBox x:Name="DiffText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="White" Padding="12" />
        </Grid>
    </Grid>
</Window>
