<Window x:Class="WorkDelta.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WorkDelta.App.Localization"
        Icon="/WorkDelta;component/Assets/WorkDelta.ico"
        Title="{loc:Loc AppName}"
        Width="1180" Height="760" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="42" Height="42"
                           Source="/WorkDelta;component/Assets/WorkDelta.png"
                           Stretch="Uniform" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc AppName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{loc:Loc Tagline}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Reports}" Click="ReportsButton_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc BackupAndRestore}" Click="BackupButton_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc SupportAuthor}" Click="SupportButton_Click" Margin="0,0,18,0" />
                    <Ellipse Width="8" Height="8" Fill="#22B07D" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc RecordingLocally}" Foreground="#35705E" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="IdentityText" Margin="22,0,0,0" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Loc TrackedProjects}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="4,2,0,12" />
                    <Button Grid.Row="1" Content="{loc:Loc AddProject}" Click="AddProject_Click" Margin="0,0,0,14" />
                    <ListBox x:Name="ProjectList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             SelectionChanged="ProjectList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="9" Background="Transparent" Padding="11,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F2F5FB" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EAF0FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" Background="#DCE6FF" VerticalAlignment="Top">
                                        <TextBlock Text="⌁" Foreground="#356AE6" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="3,14,3,2">
                        <CheckBox x:Name="StartupCheckBox" Content="{loc:Loc RunAtStartup}" Foreground="#506078"
                                  Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
                        <TextBlock Text="{loc:Loc Language}" Foreground="#506078" FontSize="11" Margin="0,12,0,4" />
                        <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged" DisplayMemberPath="Name" />
                        <TextBlock Text="{loc:Loc LocalOnly}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid x:Name="EmptyPanel">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                            <Border Width="68" Height="68" Background="#EAF0FF" CornerRadius="18" Margin="0,0,0,20">
                                <TextBlock Text="Δ" Foreground="#356AE6" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Loc AddFirstProject}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc EmptyDescription}"
                                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="23"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,12,0,24" />
                            <Button Content="{loc:Loc ChooseProject}" Click="AddProject_Click" HorizontalAlignment="Center" Padding="22,11" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="DashboardPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="98" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ProjectTitle" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <Border x:Name="StatusBadge" Background="#E8F8F2" CornerRadius="9" Margin="12,4,0,0" Padding="9,3" VerticalAlignment="Top">
                                    <TextBlock x:Name="StatusText" Text="{loc:Loc Tracking}" FontSize="10" Foreground="#16815D" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ProjectPathText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                            <DatePicker x:Name="ReportDatePicker" Width="128" Margin="0,0,8,0"
                                        SelectedDateChanged="ReportDatePicker_Changed" />
                            <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Content="{loc:Loc PauseTracking}" Click="PauseButton_Click" Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc HistoryRestore}" Click="HistoryButton_Click" Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc ProjectSettings}" Click="ProjectSettingsButton_Click" Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc CreateCheckpoint}" Click="SnapshotButton_Click" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc ExportLog}" Click="ExportButton_Click" />
                        </WrapPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17">
                            <StackPanel>
                                <TextBlock x:Name="ActivityCaption" Text="{loc:Loc SelectedDateActivity}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="DurationText" Text="{loc:Loc ZeroDuration}" Foreground="{StaticResource TextBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc FilesTouched}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="FilesText" Text="0" Foreground="{StaticResource TextBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc EffectiveChanges}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="ChangesText" Text="0" Foreground="{StaticResource TextBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,13">
                                <TextBlock x:Name="TimelineCaption" Text="{loc:Loc Timeline}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{loc:Loc TimelineHint}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </Grid>
                            <ListBox x:Name="TimelineList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="94" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding StartTime}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding EndTime}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Grid Grid.Column="1">
                                                <Rectangle Width="2" Fill="#DDE5F5" HorizontalAlignment="Center" Margin="0,9,-0,0" />
                                                <Ellipse Width="10" Height="10" Fill="#356AE6" VerticalAlignment="Top" Margin="0,5,0,0" />
                                            </Grid>
                                            <Border Grid.Column="2" Background="#F8FAFD" CornerRadius="9" Padding="14,11">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" Foreground="#2B3850" />
                                                        <Border HorizontalAlignment="Right" Background="#EAF0FF" CornerRadius="8" Padding="8,3">
                                                            <TextBlock Text="{Binding Duration}" Foreground="#356AE6" FontSize="10" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding Files}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="BusyOverlay" Grid.RowSpan="2" Background="#66000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="◌" FontSize="22" Foreground="#356AE6" Margin="0,0,12,0" />
                    <TextBlock x:Name="BusyText" Text="{loc:Loc Working}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
