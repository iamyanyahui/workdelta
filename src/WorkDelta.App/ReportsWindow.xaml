<Window x:Class="WorkDelta.App.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WorkDelta.App.Localization"
        Icon="/WorkDelta;component/Assets/WorkDelta.ico"
        Title="{loc:Loc ReportTitle}" Width="900" Height="580"
        MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:Loc WorkReports}" FontSize="23" FontWeight="SemiBold" />
        <WrapPanel Grid.Row="1" Margin="0,15,0,14" VerticalAlignment="Center">
            <TextBlock Text="{loc:Loc Range}" VerticalAlignment="Center" Margin="0,0,7,0" />
            <DatePicker x:Name="StartDatePicker" Width="135" SelectedDateChanged="Filter_Changed" />
            <TextBlock Text="{loc:Loc To}" VerticalAlignment="Center" Margin="8,0" />
            <DatePicker x:Name="EndDatePicker" Width="135" SelectedDateChanged="Filter_Changed" />
            <ComboBox x:Name="ProjectFilter" Width="170" Margin="12,0,0,0"
                      DisplayMemberPath="Name" SelectionChanged="Filter_Changed" />
            <Button Content="{loc:Loc ThisWeek}" Click="ThisWeek_Click" Margin="12,0,0,0" />
            <Button Content="{loc:Loc ThisMonth}" Click="ThisMonth_Click" Margin="7,0,0,0" />
        </WrapPanel>
        <DataGrid x:Name="ReportGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Project}" Binding="{Binding ProjectName}" Width="*" />
                <DataGridTextColumn Header="{loc:Loc Sessions}" Binding="{Binding SessionCount}" Width="100" />
                <DataGridTextColumn Header="{loc:Loc Duration}" Binding="{Binding DurationText}" Width="120" />
                <DataGridTextColumn Header="{loc:Loc FilesTouched}" Binding="{Binding FileCount}" Width="100" />
                <DataGridTextColumn Header="{loc:Loc EffectiveChanges}" Binding="{Binding ChangeCount}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="TotalText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="{loc:Loc ExportReport}" HorizontalAlignment="Right" Click="Export_Click" />
        </Grid>
    </Grid>
</Window>
